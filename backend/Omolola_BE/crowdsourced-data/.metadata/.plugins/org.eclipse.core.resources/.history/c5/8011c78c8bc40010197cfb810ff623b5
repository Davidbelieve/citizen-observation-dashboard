package com.waterquality.gateway.controller;

//Necessary imports
import org.springframework.http.*;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.client.RestTemplate;
import org.springframework.web.client.HttpClientErrorException;

@RestController
@RequestMapping("/api")
public class GatewayController {
    
    private final RestTemplate restTemplate;
    
    //Service URLs
    private static final String CROWDSOURCED_SERVICE = "http://localhost:8081";
    private static final String REWARDS_SERVICE = "http://localhost:8082";
    
    public GatewayController() {
        this.restTemplate = new RestTemplate();
    }
    
    // ==================== CROWDSOURCED SERVICE ENDPOINTS ====================
    
    //POST - Submit new observation
    @PostMapping("/observations")
    public ResponseEntity<?> submitObservation(@RequestBody Object body) {
        try {
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            HttpEntity<Object> request = new HttpEntity<>(body, headers);
            
            String url = CROWDSOURCED_SERVICE + "/observations";
            return restTemplate.exchange(url, HttpMethod.POST, request, Object.class);
        } catch (HttpClientErrorException e) {
            return ResponseEntity.status(e.getStatusCode()).body(e.getResponseBodyAsString());
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //GET - Get all observations
    @GetMapping("/observations")
    public ResponseEntity<?> getAllObservations() {
        try {
            String url = CROWDSOURCED_SERVICE + "/observations";
            return restTemplate.getForEntity(url, Object.class);
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //GET - Get observation by ID
    @GetMapping("/observations/{id}")
    public ResponseEntity<?> getObservationById(@PathVariable String id) {
        try {
            String url = CROWDSOURCED_SERVICE + "/observations/" + id;
            return restTemplate.getForEntity(url, Object.class);
        } catch (HttpClientErrorException e) {
            return ResponseEntity.status(e.getStatusCode()).body(e.getResponseBodyAsString());
        } catch (Exception e) {
            return ResponseEntity.status(404).body("{\"error\": \"Not found\"}");
        }
    }
    
    //GET - Get observations by citizen ID
    @GetMapping("/observations/citizen/{citizenId}")
    public ResponseEntity<?> getObservationsByCitizen(@PathVariable String citizenId) {
        try {
            String url = CROWDSOURCED_SERVICE + "/observations/citizen/" + citizenId;
            return restTemplate.getForEntity(url, Object.class);
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //GET - Get observations by postcode
    @GetMapping("/observations/postcode/{postcode}")
    public ResponseEntity<?> getObservationsByPostcode(@PathVariable String postcode) {
        try {
            String url = CROWDSOURCED_SERVICE + "/observations/postcode/" + postcode;
            return restTemplate.getForEntity(url, Object.class);
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //GET - Count observations by citizen ID
    @GetMapping("/observations/citizen/{citizenId}/count")
    public ResponseEntity<?> countObservationsByCitizen(@PathVariable String citizenId) {
        try {
            String url = CROWDSOURCED_SERVICE + "/observations/citizen/" + citizenId + "/count";
            return restTemplate.getForEntity(url, Object.class);
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //DELETE - Delete observation by ID
    @DeleteMapping("/observations/{id}")
    public ResponseEntity<?> deleteObservation(@PathVariable String id) {
        try {
            String url = CROWDSOURCED_SERVICE + "/observations/" + id;
            restTemplate.delete(url);
            return ResponseEntity.noContent().build();
        } catch (HttpClientErrorException e) {
            return ResponseEntity.status(e.getStatusCode()).body(e.getResponseBodyAsString());
        } catch (Exception e) {
            return ResponseEntity.status(404).body("{\"error\": \"Not found\"}");
        }
    }
    
    // ==================== REWARDS SERVICE ENDPOINTS ====================
    
    //POST - Add points for submission
    @PostMapping("/rewards/points")
    public ResponseEntity<?> addPoints(@RequestBody Object body) {
        try {
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            HttpEntity<Object> request = new HttpEntity<>(body, headers);
            
            String url = REWARDS_SERVICE + "/rewards/points";
            return restTemplate.exchange(url, HttpMethod.POST, request, Object.class);
        } catch (HttpClientErrorException e) {
            return ResponseEntity.status(e.getStatusCode()).body(e.getResponseBodyAsString());
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //GET - Get citizen rewards by citizen ID
    @GetMapping("/rewards/citizen/{citizenId}")
    public ResponseEntity<?> getCitizenRewards(@PathVariable String citizenId) {
        try {
            String url = REWARDS_SERVICE + "/rewards/citizen/" + citizenId;
            return restTemplate.getForEntity(url, Object.class);
        } catch (HttpClientErrorException e) {
            return ResponseEntity.status(e.getStatusCode()).body(e.getResponseBodyAsString());
        } catch (Exception e) {
            return ResponseEntity.status(404).body("{\"error\": \"Not found\"}");
        }
    }
    
    //GET - Get all rewards
    @GetMapping("/rewards")
    public ResponseEntity<?> getAllRewards() {
        try {
            String url = REWARDS_SERVICE + "/rewards";
            return restTemplate.getForEntity(url, Object.class);
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //GET - Get leaderboard
    @GetMapping("/rewards/leaderboard")
    public ResponseEntity<?> getLeaderboard(@RequestParam(defaultValue = "10") int limit) {
        try {
            String url = REWARDS_SERVICE + "/rewards/leaderboard?limit=" + limit;
            return restTemplate.getForEntity(url, Object.class);
        } catch (Exception e) {
            return ResponseEntity.status(500).body("{\"error\": \"" + e.getMessage() + "\"}");
        }
    }
    
    //GET - Get citizens by badge type
    @GetMapping("/rewards/badge/{badgeType}")
    public ResponseEntity<?> getCitizensByBadge(@PathVariable String badgeType) {
        try {
            String url = REWARDS_SERVICE + "/rewards/badge/" + badgeType;
            return restTemplate.getForEntity(url, Object.class);
        } catch (HttpClientErrorException e) {
            return ResponseEntity.status(e.getStatusCode()).body(e.getResponseBodyAsString());
        } catch (Exception e) {
            return ResponseEntity.status(400).body("{\"error\": \"Invalid badge type\"}");
        }
    }
    
    // ==================== HEALTH CHECK ====================
    
    //Health check endpoint
    @GetMapping("/health")
    public ResponseEntity<String> health() {
        return ResponseEntity.ok("Gateway is running on port 8080");
    }
}